# Runtime data: keep only the folder layout and this guide in Git.
/data/**
!/data/README.md
!/data/projects/
!/data/projects/.gitkeep
!/data/originals/
!/data/originals/.gitkeep
!/data/downloads/
!/data/downloads/.gitkeep
!/data/live-chunks/
!/data/live-chunks/.gitkeep
!/data/cache/
!/data/cache/.gitkeep
!/data/models/
!/data/models/.gitkeep
!/data/transcripts/
!/data/transcripts/.gitkeep
!/data/drafts/
!/data/drafts/.gitkeep
!/data/exports/
!/data/exports/.gitkeep
!/data/logs/
!/data/logs/.gitkeep

# Local secrets. Only commit example files containing placeholders.
.env
.env.*
!.env.example
.envrc
.netrc
.npmrc
cookies.txt
cookies.local.txt
credentials.json
secrets.json
secrets/
*.key
*.pem
*.p12
*.pfx

# Media and transient download artifacts outside data/ also stay local.
*.mp4
*.m4v
*.mov
*.mkv
*.webm
*.avi
*.mts
*.m2ts
*.mpg
*.mpeg
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.opus
*.ytdl
*.part
*.temp
*.log
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# Python, frontend, local builds, and IDE/OS artifacts.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/
node_modules/
.next/
.vite/
dist/
build/
coverage/
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
