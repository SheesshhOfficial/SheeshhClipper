# Optional. Local files, local analysis and public YouTube ingest need no API key.
# Copy to .env locally only; never commit your real key.
ASSEMBLYAI_API_KEY=

# Optional cloud transcript ranking. Choose a model ID from the selected provider.
# Leave either provider blank to keep it disabled. Neither sends anything by default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=

# Optional local AI. Start Ollama with OLLAMA_NO_CLOUD=1 and load a local model.
# On Windows Docker Desktop try http://host.docker.internal:11434
SHEESH_OLLAMA_URL=
SHEESH_OLLAMA_MODEL=
